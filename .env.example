# Copy this file to .env.local and add your key to enable the optional cloud
# provider. .env.local is ignored and must never be committed or shared.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Keep local AI as the default. The provider can also be chosen in the UI.
SIGNAL_DESK_AI_PROVIDER=local

# Optional advanced overrides:
# GEMINI_TIMEOUT_SECONDS=180
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
